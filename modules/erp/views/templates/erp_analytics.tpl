<div class="erp-section">
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="icon-pie-chart"></i> Occupied vs available (room nights)</h3>
                </div>
                <div class="panel-body text-center">
                    <div class="erp-scroll" style="max-height:300px;">
                        <svg width="100%" height="260" id="erp_occupancy_chart"></svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="erp-section">
    <div class="row">
        <div class="col-lg-6">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="icon-line-chart"></i> Occupancy trend</h3>
                </div>
                <div class="panel-body">
                    <div class="erp-scroll" style="max-height:200px;">
                        <svg width="100%" height="180" id="erp_trend_chart"></svg>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="icon-line-chart"></i> Revenue trend</h3>
                </div>
                <div class="panel-body">
                    <div class="erp-scroll" style="max-height:200px;">
                        <svg width="100%" height="180" id="erp_revenue_chart"></svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
